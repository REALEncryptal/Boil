--!strict
-- FeatureLoader — discovers a realm's feature modules and loads them in
-- dependency order.
--
-- What this replaces: `LoadOrdered`, which sorted by a bare `Priority` integer
-- every feature author had to guess (PlayerData = 1, Notes = 5, Health = 10).
-- Nothing checked those numbers against reality, nothing knew that Settings
-- needed PlayerData, and a feature whose dependency wasn't installed failed with
-- a raw require error deep in someone else's module.
--
-- Now each feature ships a `Manifest` (generated by tools/split from its
-- boil.toml — see that file), and the order falls out of the graph:
--
--   1. Topologically sort features by `requires` + `soft`.
--   2. Within a feature, order its modules by `Priority` (still supported, now
--      only a tiebreaker between one feature's own services).
--   3. Warn once, by name, about anything declared and not installed.
--
-- `Priority` remains useful for a feature with several services that must start
-- in a set order. It is no longer how cross-feature ordering is expressed.

local FeatureLoader = {}

export type Manifest = {
	name: string,
	folder: string,
	version: string,
	requires: { string },
	soft: { string },
	missing: { string },
}

export type Entry = {
	feature: string,
	instance: ModuleScript,
	value: any,
}

-- Features with no manifest sort after every manifested one: they declare no
-- dependencies, so nothing can depend on them, and loading them last is the only
-- safe assumption.
local UNRANKED = 1e6

local function readManifest(feature: Instance): Manifest?
	local module = feature:FindFirstChild("Manifest")
	if module == nil or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, module)
	if not ok or typeof(result) ~= "table" then
		warn(`[FeatureLoader] {feature.Name} has an unreadable Manifest: {result}`)
		return nil
	end
	return result :: Manifest
end

-- Reads every manifest under `container` (normally ReplicatedStorage.Features).
-- The container is walked GENERICALLY, so no framework code names a feature.
function FeatureLoader.manifests(container: Instance): { [string]: Manifest }
	local out: { [string]: Manifest } = {}
	for _, feature in container:GetChildren() do
		local manifest = readManifest(feature)
		if manifest then
			out[feature.Name] = manifest
		end
	end
	return out
end

-- Depth-first topological rank: a feature's rank is one more than the deepest
-- dependency it has. Cycles are reported and broken rather than hanging.
local function rankAll(manifests: { [string]: Manifest }): ({ [string]: number }, { string })
	local ranks: { [string]: number } = {}
	local visiting: { [string]: boolean } = {}
	local problems: { string } = {}

	local function rankOf(name: string): number
		local cached = ranks[name]
		if cached then
			return cached
		end
		local manifest = manifests[name]
		if manifest == nil then
			ranks[name] = UNRANKED
			return UNRANKED
		end
		if visiting[name] then
			table.insert(problems, `dependency cycle involving "{name}" — breaking it here`)
			return 0
		end

		visiting[name] = true
		local deepest = 0
		for _, list in { manifest.requires, manifest.soft } do
			for _, dependency in list do
				-- A soft dependency that isn't installed simply contributes
				-- nothing to the rank; a hard one is reported below.
				if manifests[dependency] ~= nil then
					deepest = math.max(deepest, rankOf(dependency) + 1)
				end
			end
		end
		visiting[name] = false

		ranks[name] = deepest
		return deepest
	end

	for name in manifests do
		rankOf(name)
	end
	return ranks, problems
end

-- Warn about everything a feature declared and didn't get. Called once per realm
-- at boot; returns the number of problems so an entry script can react.
function FeatureLoader.verify(container: Instance): number
	local manifests = FeatureLoader.manifests(container)
	local _, problems = rankAll(manifests)
	local count = #problems

	for _, problem in problems do
		warn(`[FeatureLoader] {problem}`)
	end

	for name, manifest in manifests do
		-- Declared against a package that isn't in this project at all.
		for _, missing in manifest.missing do
			count += 1
			warn(
				`[FeatureLoader] "{name}" requires the package "{missing}", which is `
					.. `not installed. Run \`boil add {missing}\`, or remove it from `
					.. `{name}/boil.toml.`
			)
		end
		-- Declared, resolved to a folder, and that folder isn't here.
		for _, dependency in manifest.requires do
			if manifests[dependency] == nil and container:FindFirstChild(dependency) == nil then
				count += 1
				warn(
					`[FeatureLoader] "{name}" requires the feature "{dependency}", which `
						.. `is missing from Features. "{name}" will probably error on load.`
				)
			end
		end
	end

	return count
end

-- Collect every ModuleScript under `container` whose name matches `pattern`,
-- require it, and return the results in load order.
--
-- Requires are wrapped: one feature with a syntax error must not stop the rest of
-- the game from booting, and the warning names the module so the cause is obvious
-- in the output window.
function FeatureLoader.load(container: Instance, pattern: string, graphContainer: Instance?): { any }
	local manifests = FeatureLoader.manifests(graphContainer or container)
	local ranks = rankAll(manifests)

	local entries: { Entry } = {}
	for _, feature in container:GetChildren() do
		for _, module in feature:GetDescendants() do
			if not module:IsA("ModuleScript") then
				continue
			end
			if string.match(module.Name, pattern) == nil then
				continue
			end
			local ok, value = pcall(require, module)
			if not ok then
				warn(`[FeatureLoader] failed to require {module:GetFullName()}: {value}`)
				continue
			end
			table.insert(entries, { feature = feature.Name, instance = module, value = value })
		end
	end

	table.sort(entries, function(a, b)
		local ra = ranks[a.feature] or UNRANKED
		local rb = ranks[b.feature] or UNRANKED
		if ra ~= rb then
			return ra < rb
		end
		-- Within one feature, `Priority` still orders its own services.
		local pa = (type(a.value) == "table" and tonumber((a.value :: any).Priority)) or math.huge
		local pb = (type(b.value) == "table" and tonumber((b.value :: any).Priority)) or math.huge
		if pa ~= pb then
			return pa < pb
		end
		-- Stable final tiebreak, so load order doesn't vary between sessions.
		return a.instance:GetFullName() < b.instance:GetFullName()
	end)

	local values: { any } = {}
	for _, entry in entries do
		table.insert(values, entry.value)
	end
	return values
end

return FeatureLoader
